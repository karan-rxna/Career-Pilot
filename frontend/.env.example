# Copy to .env.local (gitignored) and adjust as needed.
#
# Base URL of the Spring Boot API. Defaults to http://localhost:8080 when unset,
# so local development works with no file at all.
#
# The API only accepts browser requests from the origins in its
# CORS_ALLOWED_ORIGINS setting (http://localhost:5173 and :5174 by default), so
# if Vite starts on another port, either free 5173 or add that origin to the
# backend's configuration.
VITE_API_BASE_URL=http://localhost:8080

# Deployed frontend (Vercel) would point at the Render service instead, e.g.
# VITE_API_BASE_URL=https://careerpilot-api.onrender.com

# Optional: prefill the login form so a demo sign-in is one click. Leave these
# unset anywhere but a local machine — anything in a Vite env var is compiled
# into the browser bundle, so this is a convenience, not a secret store.
# VITE_DEMO_EMAIL=karan@careerpilot.app
# VITE_DEMO_PASSWORD=your-local-demo-password
